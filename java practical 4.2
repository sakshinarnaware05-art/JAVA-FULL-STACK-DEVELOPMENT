public class Sort {

    public static void main(String[] args) {

        int[] numbers = {99, 7, 6, 1, 100, 108};

        System.out.println("Array before sorting:");
        printArray(numbers);

        bubbleSort(numbers);

        System.out.println("Array after sorting:");
        printArray(numbers);
    }

    public static void bubbleSort(int[] arr) {
        int n = arr.length;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n - 1; j++) {

                if (arr[j] > arr[j + 1]) {

                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    public static void printArray(int[] arr) {
        for (int num : arr) {
            System.out.print(num + " ");
        }
        System.out.println();
    }
}
